# Server
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=yourpassword
DB_NAME=subscription_platform

# Payment Simulation (0.0 to 1.0 — probability of success)
PAYMENT_SUCCESS_RATE=0.7

# Retry Configuration
MAX_RETRIES=3
# Retry intervals in hours after each failed attempt (comma-separated)
RETRY_INTERVALS=1,6,24

# Background Job — cron schedule (default: every minute for demo)
CRON_SCHEDULE=* * * * *

# Email (optional — leave blank to disable)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@subscriptionplatform.com

# Webhook signing secret
WEBHOOK_SECRET=changeme-use-a-long-random-string
